'=============================================
' 宏1：图/表编号设为蓝色
'=============================================
Sub SetFigBlue()
    Dim clr As Long: clr = RGB(0, 0, 255)
    Dim prefixes As Variant
    Dim i As Long
    
    prefixes = Array("Figure", "Fig.", "Table", "Tab.", "图", "表")
    
    For i = LBound(prefixes) To UBound(prefixes)
        Dim pfx As String
        pfx = prefixes(i)
        
        With ActiveDocument.Content.Find
            .ClearFormatting
            .Replacement.ClearFormatting
            .MatchWildcards = True
            .Forward = True
            .Wrap = wdFindContinue
            .Replacement.Font.Color = clr
            
            ' 1. 复数+数字+字母后缀（大小写）：Tab.S9A / Table S39b
            .Text = pfx & "[Ss][0-9]{1,}[a-zA-Z]"
            .Execute Replace:=wdReplaceAll
            
            ' 2. 复数+数字（无后缀）：Tab.S9 / Table S39
            .Text = pfx & "[Ss][0-9]{1,}"
            .Execute Replace:=wdReplaceAll
            
            ' 3. 纯数字+字母后缀（大小写）：Tab.39A / Table 39b
            .Text = pfx & "[0-9]{1,}[a-zA-Z]"
            .Execute Replace:=wdReplaceAll
            
            ' 4. 纯数字（无后缀）：Tab.39 / Table 39
            .Text = pfx & "[0-9]{1,}"
            .Execute Replace:=wdReplaceAll
            
            ' 5. 带空格+复数+数字+字母后缀（大小写）：Tab. S9A / Table S39b
            .Text = pfx & "[ ]{1,}[Ss][0-9]{1,}[a-zA-Z]"
            .Execute Replace:=wdReplaceAll
            
            ' 6. 带空格+复数+数字：Tab. S9 / Table S39
            .Text = pfx & "[ ]{1,}[Ss][0-9]{1,}"
            .Execute Replace:=wdReplaceAll
            
            ' 7. 带空格+纯数字+字母后缀（大小写）：Tab. 39A / Table 39b
            .Text = pfx & "[ ]{1,}[0-9]{1,}[a-zA-Z]"
            .Execute Replace:=wdReplaceAll
            
            ' 8. 带空格+纯数字：Tab. 39 / Table 39
            .Text = pfx & "[ ]{1,}[0-9]{1,}"
            .Execute Replace:=wdReplaceAll
        End With
    Next i
    
    MsgBox "上色完成：所有 Fig./Figure/Table/Tab./图/表 已设为蓝色（含大小写字母后缀）", vbInformation
End Sub

